# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
# Replace with your Neon connection string from https://neon.tech
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key for Authentication
JWT_SECRET="replace-with-a-long-random-secret"

# Frontend Application URL
FRONTEND_URL="http://localhost:5173"

# Web Push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@your-domain.example"

# Cloudinary Storage (Optional during initial local testing)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
