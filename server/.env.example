# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
# Replace with your Neon connection string from https://neon.tech
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key for Authentication
JWT_SECRET="replace-with-a-long-random-secret"

# Frontend Application URL
FRONTEND_URL="http://localhost:5173"

# Email delivery via Resend (https://resend.com). Keep this key on the server only.
RESEND_API_KEY=""
EMAIL_FROM="Chore Manager <notifications@your-verified-domain.example>"

# Cloudinary Storage (Optional during initial local testing)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
